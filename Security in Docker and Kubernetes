By default docker container runs as root user inside the container. 

We can use the below option to run with different user - 

# docker run --user=1001 ubuntu sleep 1000 

vim Dockerfile -
FROM Ubuntu 
USER 1000   Even though docker runs as root user by default, still it cannot touch base machine filesystems 
  docker uses linux capabilities	to do anything - 

/usr/include/linux/capability.h   docker run ubuntu —cap-add MAC_ADMIN ubuntu 

docker run ubuntu —cap-drop MAC_ADMIN ubuntu

Run container with all privileges- 

# docker run ubuntu —privileged ubuntu 



apiVersion: v1
kind: Pod
metadata:
  name: security-context-demo
spec:
  securityContext:
    runAsUser: 1000
    runAsGroup: 3000
    supplementalGroups: [4000]
    supplementalGroupsPolicy: Strict
  containers:
  - name: sec-ctx-demo
    image: registry.k8s.io/e2e-test-images/agnhost:2.45
    command: [ "sh", "-c", "sleep 1h" ]
    securityContext:
      allowPrivilegeEscalation: false


apiVersion: v1
kind: Pod
metadata:
  name: security-context-demo-4
spec:
  containers:
  - name: sec-ctx-4
    image: gcr.io/google-samples/hello-app:2.0
    securityContext:
      capabilities:
        add: ["NET_ADMIN", "SYS_TIME"]

