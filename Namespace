# kubectl get ns 
# kubectl create ns project1 && kubectl create ns project2 && kubectl create ns project3
# kubectl create deployment  test --image=nginx   -n project1 
# kubectl create deployment  test --image=nginx   -n project2
# kubectl create deployment  test --image=nginx   -n project3

To view the available contexts - 
# kubectl config get contexs 
CURRENT             NAME                                                 CLUSTER                  AUTHINFO                 NAMESPACE
*                            kubernetes-admin@kubernetes   kubernetes             kubernetes-admin
To set  contexts - 
# kubectl config set-context project1  --namespace=project1  --user=kubernetes-admin --cluster=kubernetes             
# kubectl config set-context project2  --namespace=project1  --user=kubernetes-admin --cluster=kubernetes   
# kubectl config set-context project3  --namespace=project1  --user=kubernetes-admin --cluster=kubernetes            
          
 # kubectl config get contexs 

Switch to context project1 - 
# kubectl config use-context project1 


controlplane $ kubectl  config get-contexts  
CURRENT   NAME                          CLUSTER      AUTHINFO           NAMESPACE
*         kubernetes-admin@kubernetes   kubernetes   kubernetes-admin   
controlplane $ kubectl  create ns project1 
namespace/project1 created
controlplane $ kubectl  create ns project2 
namespace/project2 created
controlplane $ kubectl  create ns project3 
namespace/project3 created
controlplane $ kubectl config get-contexts                                               
CURRENT   NAME                          CLUSTER      AUTHINFO           NAMESPACE
*         kubernetes-admin@kubernetes   kubernetes   kubernetes-admin   
controlplane $ kubectl config set-context project1 --cluster=kubernetes --user=kubernetes-admin --namespace=project1
Context "project1" created.
controlplane $ kubectl config set-context project2 --cluster=kubernetes --user=kubernetes-admin --namespace=project2
Context "project2" created.
controlplane $ kubectl config set-context project3 --cluster=kubernetes --user=kubernetes-admin --namespace=project3
Context "project3" created.
controlplane $ kubectl  config get-contexts 
CURRENT   NAME                          CLUSTER      AUTHINFO           NAMESPACE
*         kubernetes-admin@kubernetes   kubernetes   kubernetes-admin   
          project1                      kubernetes   kubernetes-admin   project1
          project2                      kubernetes   kubernetes-admin   project2
          project3                      kubernetes   kubernetes-admin   project3

controlplane $ kubectl  config view 
apiVersion: v1
clusters:
- cluster:
    certificate-authority-data: DATA+OMITTED
    server: https://172.30.1.2:6443
  name: kubernetes
contexts:
- context:
    cluster: kubernetes
    user: kubernetes-admin
  name: kubernetes-admin@kubernetes
- context:
    cluster: kubernetes
    namespace: project1
    user: kubernetes-admin
  name: project1
- context:
    cluster: kubernetes
    namespace: project2
    user: kubernetes-admin
  name: project2
- context:
    cluster: kubernetes
    namespace: project3
    user: kubernetes-admin
  name: project3
current-context: kubernetes-admin@kubernetes
kind: Config
preferences: {}
users:
- name: kubernetes-admin
  user:
    client-certificate-data: DATA+OMITTED
    client-key-data: DATA+OMITTED


controlplane $ kubectl  config  use-context project1
Switched to context "project1".
controlplane $ kubectl  config get-contexts 
CURRENT   NAME                          CLUSTER      AUTHINFO           NAMESPACE
          kubernetes-admin@kubernetes   kubernetes   kubernetes-admin   
*         project1                      kubernetes   kubernetes-admin   project1
          project2                      kubernetes   kubernetes-admin   project2
          project3                      kubernetes   kubernetes-admin   project3


