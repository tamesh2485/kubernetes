Defaut ingress deny policy - 

---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: default-deny-ingress
  namespace: default
spec:
  podSelector: {} #### Any pod 
  policyTypes:
  - Ingress


